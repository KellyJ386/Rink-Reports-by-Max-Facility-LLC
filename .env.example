# RinkReports 3.0 — required environment variables.
# Copy to .env.local and fill in real values; never commit secrets.

# Supabase project URL (https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (publishable) key — safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — server-only. Never import from client code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional override for the tRPC base URL. Leave blank in development;
# set to your deployment origin in CI / Vercel preview if cross-origin.
NEXT_PUBLIC_TRPC_URL=

# Sentry error monitoring — server-side and client-side
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Server-side cron auth secret (Vercel cron sends as Bearer)
CRON_SECRET=

# Notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
